# Environment variables example for Gestion-d-Inventaire

# Django
SECRET_KEY=replace-me-with-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres/Neon)
DATABASE_URL=postgres://postgres:postgres@db:5432/gestion

# JWT
JWT_SECRET=replace-jwt-secret
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30
JWT_ALGORITHM=HS256

# Resend
RESEND_API_KEY=rsnd_test_xxx
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Cloudflare R2 (S3-compatible)
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id
CLOUDFLARE_R2_BUCKET=gestion-inventaire-media
CLOUDFLARE_R2_ACCESS_KEY=R2ACCESSKEY
CLOUDFLARE_R2_SECRET_KEY=R2SECRETKEY
CLOUDFLARE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
MEDIA_URL=https://<account>.r2.cloudflarestorage.com/gestion-inventaire-media/
STATIC_URL=/static/

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}

# Sentry (optional)
SENTRY_DSN=

# Notes:
# - Replace secret values in production and store them in your cloud provider secrets manager.
# - For Neon (Postgres) you'll receive a DATABASE_URL from the provider.
